<?xml version="1.0" encoding="utf-8"?>
<!-- Layout Type Demonstrated: ConstraintLayout -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/profile_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_large">

        <!-- Top Navigation Bar -->
        <ImageButton
            android:id="@+id/btnProfileBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back_button"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvProfileTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="@string/profile_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_title"
            app:layout_constraintBottom_toBottomOf="@+id/btnProfileBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnProfileBack" />

        <!-- Avatar Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProfileAvatar"
            android:layout_width="@dimen/profile_avatar_size"
            android:layout_height="@dimen/profile_avatar_size"
            android:layout_marginTop="@dimen/spacing_large"
            app:cardBackgroundColor="@color/primary_container"
            app:cardCornerRadius="50dp"
            app:cardElevation="@dimen/card_elevation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvProfileTitle"
            app:strokeColor="@color/primary"
            app:strokeWidth="2dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_profile_avatar"
                android:src="@drawable/ic_person"
                app:tint="@color/primary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Display User Name -->
        <TextView
            android:id="@+id/tvProfileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardProfileAvatar"
            tools:text="Alex Morgan" />

        <!-- Display Email -->
        <TextView
            android:id="@+id/tvProfileEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_tiny"
            android:fontFamily="sans-serif"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvProfileName"
            tools:text="student@example.com" />

        <!-- User Information Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInfoContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvProfileEmail"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/profile_details_header"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_size_subtitle" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:background="@color/divider" />

                <!-- Detail Row: Student ID -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/label_student_id"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />

                    <TextView
                        android:id="@+id/tvProfileStudentID"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/default_student_id"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>

                <!-- Detail Row: Department -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/label_department"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />

                    <TextView
                        android:id="@+id/tvProfileDepartment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/default_department"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>

                <!-- Detail Row: Session -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/label_session"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />

                    <TextView
                        android:id="@+id/tvProfileSession"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/default_session"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Button to open Digital Student Card directly -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewStudentCard"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/spacing_large"
            android:fontFamily="sans-serif-bold"
            android:text="@string/btn_view_id_card"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_size_subtitle"
            app:cornerRadius="@dimen/button_corner_radius"
            app:icon="@drawable/ic_student_card"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/spacing_small"
            app:iconTint="@color/primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardInfoContainer"
            app:strokeColor="@color/primary"
            app:strokeWidth="1.5dp" />

        <!-- Logout Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginBottom="@dimen/spacing_large"
            android:backgroundTint="@color/error"
            android:fontFamily="sans-serif-bold"
            android:text="@string/btn_logout"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_subtitle"
            app:cornerRadius="@dimen/button_corner_radius"
            app:icon="@drawable/ic_logout"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/spacing_small"
            app:iconTint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnViewStudentCard" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

